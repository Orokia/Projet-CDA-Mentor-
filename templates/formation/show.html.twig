    <div class="container detail-body">

        <div class="row g-4 g-lg-5">

            {# =================================================
               CARTE PRIX (à droite sur grand écran,
               juste sous le hero sur mobile)
               ================================================= #}

            <aside class="col-lg-4 order-lg-2">

                <div class="formation-purchase-card detail-card">

                    <div class="formation-preview">

                        {% if formation.image %}

                            <img
                                src="{{ asset('assets/images/formations/' ~ formation.image) }}"
                                alt="{{ formation.titre }}"
                            >

                        {% else %}

                            <div class="formation-image-placeholder">
                                <i class="bi bi-image" aria-hidden="true"></i>
                                Image indisponible
                            </div>

                        {% endif %}

                    </div>

                    <div class="formation-purchase-body">

                        <p class="formation-price-info">
                            Tarif de la formation
                        </p>

                        <div class="formation-price">
                            {{ formation.prix|number_format(0, ',', ' ') }} €
                        </div>

                        {% if nbFormateurs > 0 %}
                            <a
                                href="#formateurs"
                                class="btn btn-primary btn-lg w-100 formation-reservation-btn"
                            >
                                Choisir un formateur
                                <i class="bi bi-arrow-down-short" aria-hidden="true"></i>
                            </a>
                        {% endif %}

                        <ul class="detail-checklist">
                            <li>
                                <i class="bi bi-check2-circle" aria-hidden="true"></i>
                                {{ formation.duree }} heures d'accompagnement
                            </li>
                            <li>
                                <i class="bi bi-check2-circle" aria-hidden="true"></i>
                                Séances en visioconférence
                            </li>
                            <li>
                                <i class="bi bi-check2-circle" aria-hidden="true"></i>
                                Planning choisi avec votre formateur
                            </li>
                        </ul>

                    </div>

                </div>

            </aside>


            {# =================================================
               COLONNE PRINCIPALE
               ================================================= #}

            <div class="col-lg-8 order-lg-1">

                {# À PROPOS #}

                <section class="detail-section">

                    <span class="formation-section-label">
                        Présentation
                    </span>

                    <h2 class="detail-section-title">
                        À propos de cette formation
                    </h2>

                    <div class="formation-description-text">
                        {% if description %}
                            {{ description|nl2br }}
                        {% else %}
                            <p class="text-muted mb-0">
                                Aucune description pour le moment.
                            </p>
                        {% endif %}
                    </div>

                </section>


                {# INFORMATIONS PRATIQUES #}

                <section class="detail-section">

                    <span class="formation-section-label">
                        Informations
                    </span>

                    <h2 class="detail-section-title">
                        Informations pratiques
                    </h2>

                    <div class="detail-facts">

                        <div class="detail-fact">
                            <i class="bi bi-hourglass-split" aria-hidden="true"></i>
                            <span>Durée</span>
                            <strong>{{ formation.duree }} heures</strong>
                        </div>

                        <div class="detail-fact">
                            <i class="bi bi-laptop" aria-hidden="true"></i>
                            <span>Format</span>
                            <strong>En ligne</strong>
                        </div>

                        <div class="detail-fact">
                            <i class="bi bi-bookmark-star" aria-hidden="true"></i>
                            <span>Spécialité</span>
                            <strong>{{ formation.specialite ?? 'Non renseignée' }}</strong>
                        </div>

                    </div>

                </section>


                {# ÉTAPES DE RÉSERVATION #}

                <ol class="detail-steps" aria-label="Étapes de réservation">
                    <li class="is-current">
                        <span>1</span>
                        Choisir un formateur
                    </li>
                    <li>
                        <span>2</span>
                        Choisir un jour
                    </li>
                    <li>
                        <span>3</span>
                        Réserver
                    </li>
                </ol>


                {# ÉTAPE 1 - FORMATEURS #}

                <section id="formateurs" class="detail-section formation-trainers-section">

                    <span class="formation-section-label">
                        Étape 1
                    </span>

                    <h2 class="detail-section-title">
                        Choisissez votre formateur
                    </h2>

                    <p class="detail-section-text">
                        Sélectionnez le formateur avec lequel vous souhaitez
                        suivre cette formation, puis choisissez un jour.
                    </p>

                    <form
                        method="post"
                        action="{{ path('app_formation_formateur', { formationId: formation.id }) }}"
                        class="formation-trainers-form"
                    >

                        <div class="row g-3">

                            {% for formateur in formation.formateurs %}

                                <div class="col-md-6">

                                    <label class="formation-trainer-card">

                                        <input
                                            type="radio"
                                            name="formateur"
                                            value="{{ formateur.id }}"
                                            required
                                        >

                                        <span class="formation-trainer-avatar">
                                            {% if formateur.image %}
                                                <img
                                                    src="{{ asset('assets/images/utilisateurs/' ~ formateur.image) }}"
                                                    alt=""
                                                    loading="lazy"
                                                >
                                            {% else %}
                                                {{ formateur.prenom|first|upper }}{{ formateur.nom|first|upper }}
                                            {% endif %}
                                        </span>

                                        <span class="formation-trainer-info">

                                            <strong>{{ formateur }}</strong>

                                            <span class="formation-trainer-details">
                                                {% if formateur.experience %}
                                                    <span><i class="bi bi-briefcase" aria-hidden="true"></i> {{ formateur.experience }}</span>
                                                {% endif %}
                                                {% if formateur.langue %}
                                                    <span><i class="bi bi-translate" aria-hidden="true"></i> {{ formateur.langue }}</span>
                                                {% endif %}
                                            </span>

                                        </span>

                                        <span class="formation-radio" aria-hidden="true">
                                            <i class="bi bi-check-lg"></i>
                                        </span>

                                    </label>

                                </div>

                            {% else %}

                                <div class="col-12">

                                    <div class="formation-empty">

                                        <i class="bi bi-person-x" aria-hidden="true"></i>

                                        <h3>
                                            Aucun formateur disponible
                                        </h3>

                                        <p>
                                            Aucun formateur n'est actuellement
                                            associé à cette formation.
                                        </p>

                                    </div>

                                </div>

                            {% endfor %}

                        </div>

                        {% if nbFormateurs > 0 %}

                            <div class="formation-trainer-action">

                                <button type="submit" class="btn btn-primary">
                                    Continuer
                                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                </button>

                            </div>

                        {% endif %}

                    </form>

                </section>

            </div>

        </div>

    </div>

</div>

{% endblock %}
