<!DOCTYPE html>
<html lang="fr">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1">

    <title>
        {% block title %}
            Mentor
        {% endblock %}
    </title>

    <meta name="description"
          content="Mentor - Plateforme de réservation de formations">

    {% block stylesheets %}
    {% endblock %}

    {% block javascripts %}
        {{ importmap('app') }}
    {% endblock %}

</head>


<body>

    {# ==========================
       HEADER
    ========================== #}

    {% include 'Header/index.html.twig' %}


    {# ==========================
       CONTENU
    ========================== #}

    <main>

        {% block body %}
        {% endblock %}

    </main>


    {# ==========================
       FOOTER
    ========================== #}

    {% include 'Footer/index.html.twig' %}

</body>

</html>