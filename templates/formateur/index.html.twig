{% extends 'base.html.twig' %}

{% block title %}Nos formateurs - Mentor{% endblock %}

{% block body %}

{# Spécialités de tous les formateurs, sans doublon, pour les filtres #}
{% set specialites = [] %}
{% for formateur in formateurs %}
    {% for specialite in formateur.specialites %}
        {% if (specialite ~ '') not in specialites %}
            {% set specialites = specialites|merge([specialite ~ '']) %}
        {% endif %}
    {% endfor %}
{% endfor %}

<div class="formateurs-page" data-controller="formateur-search">

    {# EN-TÊTE : titre + recherche #}
    <header class="formateurs-hero">

        <div class="container-mentor formateurs-hero-grid">

            <div class="formateurs-hero-text">

                <span class="formateurs-hero-label">Nos formateurs</span>

                <h1>
                    Trouvez le formateur <span>qui vous correspond</span>
                </h1>

                <p>
                    Des professionnels expérimentés, disponibles en visio
                    pour vous accompagner dans votre apprentissage.
                </p>

                {% if formateurs|length > 0 %}

                    <div class="formateurs-hero-search">
                        <i class="bi bi-search" aria-hidden="true"></i>

                        <input
                            type="search"
                            placeholder="Rechercher par nom, spécialité ou ville"
                            aria-label="Rechercher un formateur"
                            autocomplete="off"
                            data-formateur-search-target="input"
                            data-action="input->formateur-search#search"
                        >

                        <button
                            type="button"
                            class="formateurs-search-clear"
                            aria-label="Effacer la recherche"
                            data-formateur-search-target="clear"
                            data-action="click->formateur-search#clear"
                            hidden
                        >
                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                        </button>
                    </div>

                {% endif %}

            </div>

            <div class="formateurs-hero-photo">
                <img
                    src="{{ asset('assets/images/istockphoto-496565939-612x612.jpg') }}"
                    alt="Un formateur anime une séance devant un groupe"
                    width="612"
                    height="408"
                >
            </div>

        </div>

    </header>

    <section class="formateurs-list">

        <div class="container-mentor">

            {% if formateurs|length > 0 %}

                {# TITRE DE LA LISTE + NOMBRE DE RÉSULTATS #}
                <div class="formateurs-list-heading">
                    <h2>Tous nos formateurs</h2>
                    <p
                        class="formateurs-count"
                        data-formateur-search-target="count"
                        aria-live="polite"
                    >
                        {{ formateurs|length }} formateur{{ formateurs|length > 1 ? 's' : '' }}
                    </p>
                </div>

                {# FILTRES PAR SPÉCIALITÉ #}
                <div class="formateurs-toolbar">

                    {% if specialites is not empty %}
                        <div class="formateurs-filters" role="group" aria-label="Filtrer par spécialité">

                            <button
                                type="button"
                                class="catalog-chip"
                                aria-pressed="true"
                                data-formateur-search-target="category"
                                data-categorie=""
                                data-action="formateur-search#selectCategory"
                            >
                                Toutes
                            </button>

                            {% for specialite in specialites %}
                                <button
                                    type="button"
                                    class="catalog-chip"
                                    aria-pressed="false"
                                    data-formateur-search-target="category"
                                    data-categorie="{{ specialite }}"
                                    data-action="formateur-search#selectCategory"
                                >
                                    {{ specialite }}
                                </button>
                            {% endfor %}

                        </div>
                    {% endif %}

                </div>

                {# GRILLE DES FORMATEURS #}
                <div class="row g-4">

                    {% for formateur in formateurs %}

                        {# La colonne entière est masquée pour ne pas laisser de trou dans la grille #}
                        <div
                            class="col-12 col-md-6 col-xl-4"
                            data-formateur-search-target="item"
                            data-formateur-search="{{ (formateur.prenom ~ ' ' ~ formateur.nom ~ ' ' ~ (formateur.specialites|join(' ')) ~ ' ' ~ (formateur.localisation ?? ''))|lower|e('html_attr') }}"
                            data-specialites="{{ formateur.specialites|join('|')|e('html_attr') }}"
                        >

                            {% include 'components/formateur_card.html.twig' with {
                                formateur: formateur
                            } %}

                        </div>

                    {% endfor %}

                </div>

                {# AFFICHER PLUS : la liste est découpée par paquets de 8 #}
                <div class="formateurs-more">
                    <button
                        type="button"
                        class="btn-mentor btn-mentor-outline"
                        data-formateur-search-target="more"
                        data-action="formateur-search#showMore"
                        hidden
                    >
                        Afficher plus de formateurs
                    </button>
                </div>

                {# MESSAGE SI LA RECHERCHE NE DONNE RIEN #}
                <div class="empty-state mt-4" data-formateur-search-target="empty" hidden>
                    <span class="empty-state-icon" aria-hidden="true">
                        <i class="bi bi-search"></i>
                    </span>
                    <h3>Aucun résultat</h3>
                    <p>
                        Essayez un autre nom, une autre ville ou une autre spécialité.
                    </p>
                </div>

            {% else %}

                {# MESSAGE SI AUCUN FORMATEUR N'EST DISPONIBLE #}
                <div class="empty-state">
                    <span class="empty-state-icon" aria-hidden="true">
                        <i class="bi bi-person-x"></i>
                    </span>
                    <h3>Aucun formateur disponible</h3>
                    <p>
                        Aucun formateur n'est actuellement disponible.
                    </p>
                </div>

            {% endif %}

        </div>

    </section>

</div>

{% endblock %}
