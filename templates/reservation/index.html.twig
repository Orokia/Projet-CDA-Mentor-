
{% extends 'base.html.twig' %}

{% block title %}
    Mes réservations - Mentor
{% endblock %}

{% block body %}

<div class="container py-5">

    {# EN-TÊTE DE LA PAGE #}
    <div class="mb-5">
        <span class="text-primary fw-semibold">
            MON ESPACE
        </span>

        <h1 class="mt-2">
            Mes réservations
        </h1>

        <p class="text-muted">
            Retrouvez toutes vos séances, regroupées par formation.
        </p>
    </div>

    {# VÉRIFICATION DES RÉSERVATIONS #}
    {% if reservationsParFormation|length > 0 %}

        <div class="reservations-groups">

            {# UNE CARTE PAR FORMATION #}
            {% for groupe in reservationsParFormation %}

                <section class="reservation-group mb-4">

                    {# EN-TÊTE DE LA FORMATION #}
                    <div class="reservation-group-header">

                        <div class="reservation-group-icon">
                            <i class="bi bi-mortarboard"></i>
                        </div>

                        <div class="reservation-group-title">
                            <small>FORMATION</small>

                            <h2>
                                {{ groupe.formation.titre }}
                            </h2>

                            <p>
                                {{ groupe.reservations|length }}
                                séance(s) réservée(s)
                            </p>
                        </div>

                    </div>

                    {# LISTE DES SÉANCES DE CETTE FORMATION #}
                    <div class="reservation-sessions">

                        {% for reservation in groupe.reservations %}

                            <article class="reservation-session">

                                {# DATE ET HORAIRES #}
                                <div class="reservation-session-date">

                                    <div class="reservation-date-icon">
                                        <i class="bi bi-calendar3"></i>
                                    </div>

                                    <div>
                                        <small class="text-muted">
                                            Date et heure
                                        </small>

                                        <strong>
                                            {{ reservation.dateHeureDebut|date('d/m/Y') }}
                                        </strong>

                                        <span>
                                            {{ reservation.dateHeureDebut|date('H:i') }}
                                            -
                                            {{ reservation.dateHeureFin|date('H:i') }}
                                        </span>
                                    </div>

                                </div>

                                {# FORMATEUR #}
                                <div class="reservation-session-trainer">

                                    <i class="bi bi-person"></i>

                                    <div>
                                        <small class="text-muted">
                                            Formateur
                                        </small>

                                        <span>
                                            {{ reservation.formateur.prenom }}
                                            {{ reservation.formateur.nom }}
                                        </span>
                                    </div>

                                </div>

                                {# STATUT #}
                                <div class="reservation-session-status">

                                    <small class="text-muted d-block mb-2">
                                        Statut
                                    </small>

                                    {% if reservation.statut == 'confirmée' %}

                                        <span class="badge bg-success">
                                            Confirmée
                                        </span>

                                    {% elseif reservation.statut == 'annulée' %}

                                        <span class="badge bg-danger">
                                            Annulée
                                        </span>

                                    {% else %}

                                        <span class="badge bg-secondary">
                                            {{ reservation.statut }}
                                        </span>

                                    {% endif %}

                                </div>

                                {# VISIOCONFÉRENCE #}
                                <div class="reservation-session-action">

                                    {% if reservation.lienVisio
                                        and reservation.statut == 'confirmée' %}

                                        <a
                                            href="{{ reservation.lienVisio }}"
                                            class="btn btn-primary"
                                            target="_blank"
                                            rel="noopener noreferrer"
                                        >
                                            <i class="bi bi-camera-video me-2"></i>
                                            Rejoindre
                                        </a>

                                    {% else %}

                                        <span class="text-muted small">
                                            Visioconférence indisponible
                                        </span>

                                    {% endif %}

                                </div>

                            </article>

                        {% endfor %}

                    </div>

                </section>

            {% endfor %}

        </div>

    {% else %}

        {# AUCUNE RÉSERVATION #}
        <div class="text-center py-5">

            <div class="mb-3">
                <i class="bi bi-calendar-x display-4 text-muted"></i>
            </div>

            <h3>
                Aucune réservation
            </h3>

            <p class="text-muted">
                Vous n'avez pas encore réservé de formation.
            </p>

            <a
                href="{{ path('app_formation') }}"
                class="btn btn-primary"
            >
                Découvrir les formations
            </a>

        </div>

    {% endif %}

</div>

{% endblock %}
