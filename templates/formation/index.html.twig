{% extends 'base.html.twig' %}

{% block title %}Mentor - Nos formations{% endblock %}

{% block body %}

<section class="formations-page">

    <div class="container py-5">

        <div class="text-center mb-5">
            <span class="badge bg-primary mb-3">
                Mentor
            </span>

            <h1 class="display-5 fw-bold">
                Découvrez nos formations
            </h1>

            <p class="lead text-muted">
                Développez vos compétences avec nos formations.
            </p>
        </div>

        {% if formations|length > 0 %}

            <div class="row g-4">

                {% for formation in formations %}

                    <div class="col-6 col-md-4 col-lg-3">

                        {% include 'components/formation_card.html.twig' with {
                            formation: formation
                        } %}

                    </div>

                {% endfor %}

            </div>

        {% else %}

            <div class="text-center py-5">
                <h3>Aucune formation disponible</h3>
                <p class="text-muted">
                    Aucune formation n'est actuellement disponible.
                </p>
            </div>

        {% endif %}

    </div>

</section>

{% endblock %}