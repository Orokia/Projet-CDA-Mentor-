{% extends 'base.html.twig' %}

{% block title %}
    {{ formateur.prenom }} {{ formateur.nom }} - Mentor
{% endblock %}

{% block body %}

{% set nbDisponibilites = formateur.disponibilites|length %}

<div class="formateur-profile">

    <div class="container py-5">

        <nav class="formateur-breadcrumb" aria-label="Fil d'Ariane">
            <a href="{{ path('app_formateurs') }}">Formateurs</a>
            <i class="bi bi-chevron-right" aria-hidden="true"></i>
            <span>{{ formateur.prenom }} {{ formateur.nom }}</span>
        </nav>


        {# =====================================================
           VIDÉO DE PRÉSENTATION
           ===================================================== #}

        <section class="formateur-video-section">

            {% if formateur.videoPresentation %}

                <div class="formateur-video">

                    {# preload="metadata" : la vidéo n'est téléchargée qu'à la lecture #}
                    <video controls preload="metadata">
                        <source
                            src="{{ asset('assets/videos/formateurs/' ~ formateur.videoPresentation) }}"
                            type="video/mp4"
                        >

                        Votre navigateur ne supporte pas la lecture vidéo.
                    </video>

                </div>

            {% else %}

                <div class="formateur-video-empty">

                    <i class="bi bi-camera-video-off" aria-hidden="true"></i>

                    <p>
                        Aucune vidéo de présentation disponible.
                    </p>

                </div>

            {% endif %}

        </section>


        {# =====================================================
           INFORMATIONS PRINCIPALES
           ===================================================== #}

        <section class="formateur-profile-header">

            <div class="formateur-profile-photo">

                {% if formateur.image %}

                    <img
                        src="{{ asset('assets/images/utilisateurs/' ~ formateur.image) }}"
                        alt="{{ formateur.prenom }} {{ formateur.nom }}"
                    >

                {% else %}

                    <div class="formateur-profile-avatar">
                        {{ formateur.prenom|first|upper }}{{ formateur.nom|first|upper }}
                    </div>

                {% endif %}

            </div>

            <h1>
                {{ formateur.prenom }} {{ formateur.nom }}
            </h1>

            <p class="formateur-profile-role">
                Formateur Mentor
            </p>

            <div class="formateur-profile-actions">

                <a href="#reservation" class="btn btn-primary">
                    <i class="bi bi-calendar-check me-2" aria-hidden="true"></i>
                    Réserver une session
                </a>

                {% if formateur.email %}
                    <a href="mailto:{{ formateur.email }}" class="btn btn-outline-primary">
                        <i class="bi bi-envelope me-2" aria-hidden="true"></i>
                        Contacter
                    </a>
                {% endif %}

            </div>

        </section>


        {# =====================================================
           INFORMATIONS
           ===================================================== #}

        <section class="formateur-profile-informations">

            <div class="row g-3">

                <div class="col-md-6">

                    <div class="formateur-info-item">

                        <i class="bi bi-briefcase" aria-hidden="true"></i>

                        <div>
                            <span>Expérience</span>

                            <strong>
                                {{ formateur.experience ?: 'Non renseignée' }}
                            </strong>
                        </div>

                    </div>

                </div>


                <div class="col-md-6">

                    <div class="formateur-info-item">

                        <i class="bi bi-translate" aria-hidden="true"></i>

                        <div>
                            <span>Langue</span>

                            <strong>
                                {{ formateur.langue ?: 'Non renseignée' }}
                            </strong>
                        </div>

                    </div>

                </div>


                <div class="col-md-6">

                    <div class="formateur-info-item">

                        <i class="bi bi-geo-alt" aria-hidden="true"></i>

                        <div>
                            <span>Localisation</span>

                            <strong>
                                {{ formateur.localisation ?: 'Non renseignée' }}
                            </strong>
                        </div>

                    </div>

                </div>


                <div class="col-md-6">

                    <div class="formateur-info-item">

                        <i class="bi bi-book" aria-hidden="true"></i>

                        <div>

                            <span>Spécialités</span>

                            <strong>
                                {% for specialite in formateur.specialites %}
                                    {{ specialite }}{% if not loop.last %}, {% endif %}
                                {% else %}
                                    Non renseignées
                                {% endfor %}
                            </strong>

                        </div>

                    </div>

                </div>

            </div>

        </section>


        {# =====================================================
           FORMATIONS
           ===================================================== #}

        <section class="formateur-formations-section">

            <div class="formateur-section-header">

                <span class="formation-section-label">
                    Formations
                </span>

                <h2>
                    Formations animées
                </h2>

            </div>

            <div class="row g-4">

                {% for formation in formateur.formation %}

                    <div class="col-12 col-sm-6 col-lg-3">

                        <div class="formateur-formation-card">

                            <div class="formateur-formation-image">
                                {% if formation.image %}
                                    <img
                                        src="{{ asset('assets/images/formations/' ~ formation.image) }}"
                                        alt=""
                                        loading="lazy"
                                    >
                                {% else %}
                                    <i class="bi bi-journal-bookmark" aria-hidden="true"></i>
                                {% endif %}
                            </div>

                            <div class="formateur-formation-body">

                                <h3>
                                    {{ formation.titre }}
                                </h3>

                                <p class="formateur-formation-meta">
                                    <span><i class="bi bi-clock" aria-hidden="true"></i> {{ formation.duree }} h</span>
                                    <span>{{ formation.prix|number_format(0, ',', ' ') }} €</span>
                                </p>

                                <a
                                    href="{{ path('app_formation_show', { id: formation.id }) }}"
                                    class="btn btn-outline-primary btn-sm"
                                >
                                    Voir la formation
                                </a>

                            </div>

                        </div>

                    </div>

                {% else %}

                    <div class="col-12">

                        <p class="text-muted mb-0">
                            Aucune formation disponible.
                        </p>

                    </div>

                {% endfor %}

            </div>

        </section>


