{% extends 'base.html.twig' %}

{% block title %}
    Mes réservations - Mentor
{% endblock %}

{% block body %}

{% set maintenant = date() %}

<div class="container-mentor page-section reservations-page">

    {# EN-TÊTE DE LA PAGE #}
    <header class="reservations-header">
        <span class="reservations-eyebrow">Mon espace</span>
        <h1>Mes réservations</h1>
        <p>Retrouvez toutes vos séances, regroupées par formation. Cliquez sur une formation pour voir ses séances.</p>
    </header>

    {% if reservationsParFormation|length > 0 %}

        <div class="reservations-groups">

            {# UN MENU DÉROULANT PAR FORMATION (details/summary : sans JavaScript, accessible au clavier) #}
            {% for groupe in reservationsParFormation %}

                {% set seances = groupe.reservations|sort((a, b) => a.dateHeureDebut <=> b.dateHeureDebut) %}
                {% set aVenir = seances|filter(r => r.dateHeureDebut >= maintenant and r.statut != constant('App\\Entity\\Reservation::STATUT_ANNULEE')) %}
                {% set prochaine = aVenir|first %}

                {# Autres participants distincts : les formateurs pour un étudiant, les étudiants pour un formateur #}
                {% set participants = [] %}
                {% for reservation in seances %}
                    {% set participant = app.user.student ? reservation.formateur : reservation.student %}
                    {% set nom = participant.prenom ~ ' ' ~ participant.nom %}
                    {% if nom not in participants %}
                        {% set participants = participants|merge([nom]) %}
                    {% endif %}
                {% endfor %}

                <details class="reservation-group" {% if reservationsParFormation|length == 1 %}open{% endif %}>

                    <summary class="reservation-group-summary">

                        <span class="reservation-group-icon" aria-hidden="true">
                            <i class="bi bi-mortarboard"></i>
                        </span>

                        <span class="reservation-group-title">
                            <strong>{{ groupe.formation.titre }}</strong>
                            <span>
                                {{ participants|join(', ') }}
                                ·
                                {{ seances|length }} séance{{ seances|length > 1 ? 's' : '' }}
                            </span>
                        </span>

                        <span class="reservation-group-next">
                            {% if prochaine %}
                                <small>Prochaine séance</small>
                                <span>{{ prochaine.dateHeureDebut|date('d/m/Y') }} à {{ prochaine.dateHeureDebut|date('H:i') }}</span>
                            {% else %}
                                <small>Aucune séance à venir</small>
                            {% endif %}
                        </span>

                        <span class="reservation-group-chevron" aria-hidden="true">
                            <i class="bi bi-chevron-down"></i>
                        </span>

                    </summary>

                    {# SÉANCES DE CETTE FORMATION #}
                    <div class="reservation-sessions">

                        {% for reservation in seances %}

                            {% set passee = reservation.dateHeureFin < maintenant %}

                            <article class="reservation-session{{ passee ? ' is-past' : '' }}">

                                <div class="reservation-session-date">
                                    <span class="reservation-session-day" aria-hidden="true">
                                        <span>{{ reservation.dateHeureDebut|date('d') }}</span>
                                        <small>{{ reservation.dateHeureDebut|date('m/Y') }}</small>
                                    </span>
                                    <div>
                                        <strong>
                                            <time datetime="{{ reservation.dateHeureDebut|date('Y-m-d\\TH:i') }}">
                                                {{ reservation.dateHeureDebut|date('d/m/Y') }}
                                            </time>
                                        </strong>
                                        <span>
                                            {{ reservation.dateHeureDebut|date('H:i') }}
                                            -
                                            {{ reservation.dateHeureFin|date('H:i') }}
                                        </span>
                                    </div>
                                </div>

                                {# AUTRE PARTICIPANT : le formateur pour un étudiant, et inversement #}
                                {% set participant = app.user.student ? reservation.formateur : reservation.student %}
                                <div class="reservation-session-trainer">
                                    <small class="reservation-label">{{ app.user.student ? 'Formateur' : 'Étudiant' }}</small>
                                    <span>{{ participant.prenom }} {{ participant.nom }}</span>
                                </div>

                                {# STATUT : icône + texte, sans couleur #}
                                <div class="reservation-session-status">
                                    {% if reservation.estConfirmee %}
                                        <span class="reservation-status">
                                            <i class="bi bi-check-circle" aria-hidden="true"></i>
                                            Confirmée
                                        </span>
                                    {% elseif reservation.statut == constant('App\\Entity\\Reservation::STATUT_ANNULEE') %}
                                        <span class="reservation-status reservation-status--muted">
                                            <i class="bi bi-x-circle" aria-hidden="true"></i>
                                            Annulée
                                        </span>
                                    {% else %}
                                        <span class="reservation-status">
                                            <i class="bi bi-hourglass-split" aria-hidden="true"></i>
                                            {{ reservation.statut|capitalize }}
                                        </span>
                                    {% endif %}
                                    {% if passee %}
                                        <span class="reservation-label">Terminée</span>
                                    {% endif %}
                                </div>

                                <div class="reservation-session-action">
                                    {# Salle de visio intégrée (page app_reservation_visio) #}
                                    {% if reservation.lienVisio and reservation.estConfirmee %}
                                        <a
                                            href="{{ path('app_reservation_visio', {id: reservation.id}) }}"
                                            class="reservation-join"
                                        >
                                            <i class="bi bi-camera-video" aria-hidden="true"></i>
                                            Rejoindre
                                            <span class="visually-hidden">la séance du {{ reservation.dateHeureDebut|date('d/m/Y') }}</span>
                                        </a>
                                    {% else %}
                                        <span class="reservation-label">Visioconférence indisponible</span>
                                    {% endif %}
                                </div>

                            </article>

                        {% endfor %}

                    </div>

                </details>

            {% endfor %}

        </div>

    {% else %}

        {# AUCUNE RÉSERVATION #}
        <div class="reservations-empty">
            <i class="bi bi-calendar-x" aria-hidden="true"></i>
            <h3>Aucune réservation</h3>
            <p>Vous n'avez pas encore réservé de formation.</p>
            <a href="{{ path('app_formation') }}" class="reservation-join">
                Découvrir les formations
            </a>
        </div>

    {% endif %}

</div>

{% endblock %}
