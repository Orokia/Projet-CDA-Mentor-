{% extends 'base.html.twig' %}

{% block title %}Mentor - Nos formations{% endblock %}

{% block body %}

{# Liste des spécialités présentes dans le catalogue, sans doublon #}
{% set categories = [] %}
{% for formation in formations %}
    {% if formation.specialite and (formation.specialite ~ '') not in categories %}
        {% set categories = categories|merge([formation.specialite ~ '']) %}
    {% endif %}
{% endfor %}

<section class="formations-page page-section">

    <div class="container-mentor">

        <header class="catalog-header">
            <h1>
                Découvrez nos formations
            </h1>

            <p>
                Développez vos compétences avec nos formations.
            </p>
        </header>

        {% if formations|length > 0 %}

            <div data-controller="formation-search">

                {# RECHERCHE ET FILTRES #}
                <div class="catalog-toolbar">

                    <div class="catalog-search">
                        <i class="bi bi-search" aria-hidden="true"></i>

                        <input
                            type="search"
                            placeholder="Rechercher une formation"
                            aria-label="Rechercher une formation"
                            autocomplete="off"
                            data-formation-search-target="input"
                            data-action="input->formation-search#filter"
                        >
                    </div>

                    {% if categories is not empty %}
                        <div class="catalog-categories" role="group" aria-label="Filtrer par spécialité">
                            {% for categorie in categories %}
                                <button
                                    type="button"
                                    class="catalog-chip"
                                    aria-pressed="false"
                                    data-categorie="{{ categorie }}"
                                    data-formation-search-target="category"
                                    data-action="formation-search#selectCategory"
                                >
                                    {{ categorie }}
                                </button>
                            {% endfor %}
                        </div>
                    {% endif %}

                </div>

                <p
                    class="catalog-count"
                    data-formation-search-target="count"
                    aria-live="polite"
                    hidden
                ></p>

                <div class="row g-4">

                    {% for formation in formations %}

                        <div
                            class="col-12 col-sm-6 col-md-4 col-lg-3"
                            data-formation-search-target="item"
                            data-categorie="{{ formation.specialite ? formation.specialite ~ '' }}"
                            data-formation-search="{{ (formation.titre ~ ' ' ~ (formation.specialite ?? '') ~ ' ' ~ (formation.formateurs|join(' ')))|e('html_attr') }}"
                        >

                            {% include 'components/formation_card.html.twig' with {
                                formation: formation
                            } %}

                        </div>

                    {% endfor %}

                </div>

                <div class="empty-state mt-4" data-formation-search-target="empty" hidden>
                    <span class="empty-state-icon" aria-hidden="true">
                        <i class="bi bi-search"></i>
                    </span>
                    <h3>Aucun résultat</h3>
                    <p>
                        Essayez un autre mot-clé ou retirez le filtre de spécialité.
                    </p>
                </div>

            </div>

        {% else %}

            <div class="empty-state">
                <span class="empty-state-icon" aria-hidden="true">
                    <i class="bi bi-journal-x"></i>
                </span>
                <h3>Aucune formation disponible</h3>
                <p>
                    Aucune formation n'est actuellement disponible.
                </p>
            </div>

        {% endif %}

    </div>

</section>

{% endblock %}
