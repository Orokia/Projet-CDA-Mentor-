# Variables de l'environnement "ci" (tests lancés par GitHub Actions)
KERNEL_CLASS='App\Kernel'
APP_SECRET="secret"

# Base SQLite fichier : le schéma est recréé par tests/bootstrap.php,
# chaque test est isolé par DAMA DoctrineTestBundle (rollback).
DATABASE_URL="sqlite:///%kernel.project_dir%/var/ci.db"
MAILER_DSN=null://null
