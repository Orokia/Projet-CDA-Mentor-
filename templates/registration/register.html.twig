            </span>

            <h1>Créer un compte</h1>

            <p>
                Rejoignez Mentor et réservez vos premières séances.
            </p>

        </div>

        {{ form_start(registrationForm, {attr: {novalidate: 'novalidate'}}) }}

        {{ form_errors(registrationForm) }}

        <div class="row g-3">

