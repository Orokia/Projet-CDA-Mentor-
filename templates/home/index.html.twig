{% extends 'base.html.twig' %}

{% block title %}Mentor - Plateforme de formation{% endblock %}

{% block body %}

    {# =========================
       HERO
    ========================== #}

    <section class="hero">
        <div class="container-mentor">

            <div class="hero-content">

                <div class="hero-text">

                    <span class="hero-badge">
                        Plateforme de formation
                    </span>

                    <h1>
                        Apprenez avec les meilleurs formateurs.
                    </h1>

                    <p>
                        Réservez une session de formation individuelle
                        ou en groupe avec des professionnels qualifiés.
                    </p>

                    <div class="hero-actions">

                        <a href="#" class="btn-mentor btn-mentor-primary">
                            Découvrir les formations
                        </a>

                        <a href="#" class="btn-mentor btn-mentor-outline">
                            Trouver un formateur
                        </a>

                    </div>

                </div>

                <div class="hero-image">

                    <img
                        src="{{ asset('images/hero.png') }}"
                        alt="Formation en ligne avec Mentor"
                    >

                </div>

            </div>

        </div>
    </section>


    {# =========================
       FORMATIONS
    ========================== #}

    <section class="formations-section">

        <div class="container-mentor">

            <div class="section-heading">

                <span class="section-label">
                    Nos formations
                </span>

                <h2>
                    Développez vos compétences
                </h2>

                <p>
                    Choisissez la formation adaptée à vos besoins
                    et progressez avec un formateur qualifié.
                </p>

            </div>


            <div class="formations-grid">

                {% for i in 1..6 %}

                    <article class="formation-card">

                        <div class="formation-image">

                            <img
                                src="{{ asset('images/formation1.jpg') }}"
                                alt="Formation Développement Web"
                            >

                        </div>

                        <div class="formation-content">

                            <span class="formation-category">
                                Développement Web
                            </span>

                            <h3>
                                Symfony 7
                            </h3>

                            <p>
                                Apprenez à créer des applications
                                professionnelles avec Symfony.
                            </p>

                            <div class="formation-footer">

                                <strong>
                                    250 €
                                </strong>

                                <a href="#" class="btn-mentor btn-mentor-primary">
                                    Voir
                                </a>

                            </div>

                        </div>

                    </article>

                {% endfor %}

            </div>

        </div>

    </section>


    {# =========================
       FORMATEURS
    ========================== #}

    <section class="formateurs-section">

        <div class="container-mentor">

            <div class="formateurs-content">

                <div class="formateurs-image">

                    <img
                        src="{{ asset('images/instructor.jpg') }}"
                        alt="Formateur Mentor"
                    >

                </div>

                <div class="formateurs-text">

                    <span class="section-label">
                        Nos formateurs
                    </span>

                    <h2>
                        Apprenez auprès de professionnels expérimentés
                    </h2>

                    <p>
                        Des experts dans leur domaine, disponibles
                        pour vous accompagner avec des formations
                        personnalisées.
                    </p>

                    <ul>

                        <li>
                            <span>✓</span>
                            Plus de 50 formateurs
                        </li>

                        <li>
                            <span>✓</span>
                            Sessions en ligne
                        </li>

                        <li>
                            <span>✓</span>
                            Planning flexible
                        </li>

                        <li>
                            <span>✓</span>
                            Avis vérifiés
                        </li>

                    </ul>

                    <a href="#" class="btn-mentor btn-mentor-primary">
                        Voir tous les formateurs
                    </a>

                </div>

            </div>

        </div>

    </section>

{% endblock %}