{% extends 'base.html.twig' %}

{% block title %}
    Nos formateurs - Mentor
{% endblock %}

{% block body %}

<div class="formateurs-page py-5">

    <div class="container">

        {# =====================================================
           EN-TÊTE
           ===================================================== #}

        <div class="formateurs-page-header text-center mb-5">

            <span class="formation-section-label">
                Nos formateurs
            </span>

            <h1>
                Trouvez le formateur qui vous correspond
            </h1>

            <p class="text-muted mx-auto">
                Découvrez nos formateurs et choisissez celui qui
                vous accompagnera dans votre apprentissage.
            </p>

        </div>


        {# =====================================================
           LISTE DES FORMATEURS
           ===================================================== #}

        {% if formateurs|length > 0 %}

            <div class="row g-4">

                {% for formateur in formateurs %}

                    <div class="col-12 col-md-6 col-lg-4">

                        {% include 'components/formateur_card.html.twig' with {
                            formateur: formateur
                        } %}

                    </div>

                {% endfor %}

            </div>

        {% else %}

            <div class="formateurs-empty text-center py-5">

                <h3>
                    Aucun formateur disponible
                </h3>

                <p>
                    Aucun formateur n'est actuellement disponible.
                </p>

            </div>

        {% endif %}

    </div>

</div>

{% endblock %}