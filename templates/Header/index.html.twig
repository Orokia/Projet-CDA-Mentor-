<header class="mentor-header">

    <div class="container-mentor mentor-header-container">

        {# LOGO #}

        <a href="{{ path('app_home') }}"
           class="mentor-logo">

            <div class="mentor-logo-icon">
                
            </div>

            <div class="mentor-logo-text">

                <strong>
                    Mentor
                </strong>

                <span>
                    Apprendre. Progresser. Réussir.
                </span>

            </div>

        </a>


        {# NAVIGATION #}

        <nav class="mentor-navigation">

            <a href="{{ path('app_home') }}">
                Accueil
            </a>

            <a href="#">
                Formations
            </a>

            <a href="#">
                Formateurs
            </a>

            <a href="#">
                À propos
            </a>

        </nav>


        {# ACTIONS #}

        <div class="mentor-header-actions">

            {% if app.user %}

                <span class="mentor-user">

                    

                    {{ app.user.email }}

                </span>

                <a href="{{ path('app_logout') }}"
                   class="btn-mentor btn-mentor-outline">

                    Déconnexion

                </a>

            {% else %}

                <a href="{{ path('app_login') }}">

                    Se connecter

                </a>

                <a href="{{ path('app_register') }}"
                   class="btn-mentor btn-mentor-primary">

                    S'inscrire

                </a>

            {% endif %}

        </div>

    </div>

</header>