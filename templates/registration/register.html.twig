{% extends 'base.html.twig' %}

{# Le thème Bootstrap 5 ajoute is-invalid et place les erreurs sous chaque champ #}
{% form_theme registrationForm 'bootstrap_5_layout.html.twig' %}

{% block title %}Créer un compte - Mentor{% endblock %}

{% block body %}

