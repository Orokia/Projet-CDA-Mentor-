<header class="mentor-header">

    <div class="container-mentor mentor-header-container">

        {# LOGO #}

        <a href="{{ path('app_home') }}"
           class="mentor-logo">

            <div class="mentor-logo-icon">
                
            </div>

            <div class="mentor-logo-text">

                <strong>
                    Mentor
                </strong>

                <span>
                    Apprendre. Progresser. Réussir.
                </span>

            </div>

        </a>


        {# NAVIGATION #}

        <nav class="mentor-navigation">

            <a href="{{ path('app_home') }}">
                Accueil
            </a>

            <a href="{{ path('app_formation') }}">
                Formations
            </a>

            <a href="{{ path('app_formateurs') }}">
                Formateurs
            </a>

            <a href="#">
                À propos
            </a>

        </nav>


        {# ACTIONS #}

        <div class="mentor-header-actions">

            {% if app.user %}

                 <div
                    class="navbar-profile"
                    data-controller="profile-menu"
                    data-action="click@window->profile-menu#closeOnClickOutside keydown.esc@window->profile-menu#close turbo:before-cache@document->profile-menu#close"
                 >

                       <button
    type="button"
    class="profile-avatar"
    id="profileMenuButton"
    aria-label="Ouvrir le menu du profil"
    aria-haspopup="true"
    aria-expanded="false"
    data-profile-menu-target="button"
    data-action="profile-menu#toggle"
>
    {% if app.user.photoUtilisateur %}
        <img
            src="{{ asset('uploads/students/' ~ app.user.photoUtilisateur) }}"
            alt="Photo de profil"
        >
    {% else %}
        {{ app.user.prenomUtilisateur|first|upper }}{{ app.user.nomUtilisateur|first|upper }}
    {% endif %}
</button>

                        <div class="profile-dropdown">

                           <div class="profile-dropdown-header">

    <div class="profile-avatar-large">
        {% if app.user.photoUtilisateur %}
            <img
                src="{{ asset('uploads/students/' ~ app.user.photoUtilisateur) }}"
                alt="Photo de profil"
            >
        {% else %}
            {{ app.user.prenomUtilisateur|first|upper }}{{ app.user.nomUtilisateur|first|upper }}
        {% endif %}
    </div>

    <div>
        <strong>
            {{ app.user.prenomUtilisateur }} {{ app.user.nomUtilisateur }}
        </strong>

        <span>
            {{ app.user.email }}
        </span>
    </div>

</div>


                            <div class="profile-dropdown-links">

                              <a href="{{ path('app_student_profile') }}">
                                   Mon profil
                              </a>

                               
                                <a href="{{ path('app_mes_reservations') }}">
                                    Mes réservations
                                </a>

                               

                            </div>


                            <div class="profile-dropdown-footer">

                                <a href="{{ path('app_logout') }}">
                                    Déconnexion
                                </a>

                            </div>

                        </div>

                  

                </div>

            {% else %}

                <a href="{{ path('app_login') }}">

                    Se connecter

                </a>

                <a href="{{ path('app_register') }}"
                   class="btn-mentor btn-mentor-primary">

                    S'inscrire

                </a>

            {% endif %}

        </div>

    </div>

</header>