# Valeurs par défaut des variables d'environnement, chargées dans tous les environnements.
# Ordre de priorité (du plus faible au plus fort) :
#
#  * .env                valeurs par défaut (ce fichier, versionné)
#  * .env.local          surcharges locales (non versionné)
#  * .env.$APP_ENV       valeurs propres à un environnement (versionné)
#  * .env.$APP_ENV.local surcharges locales propres à un environnement (non versionné)
#
# Les vraies variables d'environnement (Docker, serveur) l'emportent sur les fichiers .env.
#
# AUCUN SECRET DE PRODUCTION ICI NI DANS UN AUTRE FICHIER VERSIONNÉ.
# En production, APP_SECRET, DATABASE_URL, MAILER_DSN, DEFAULT_URI et JAAS_* sont
# fournis comme variables d'environnement au lancement du conteneur.
# https://symfony.com/doc/current/configuration/secrets.html

###> symfony/framework-bundle ###
APP_ENV=dev
# Vide volontairement : défini dans .env.dev (dev), .env.test / .env.ci (tests)
# et par variable d'environnement en production.
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# URL publique du site, utilisée pour générer les liens hors requête HTTP (e-mails, commandes).
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Valeur indicative : la vraie URL se définit dans .env.local (dev) ou par variable d'environnement (prod).
DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/mentor?serverVersion=8.0.32&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# Le vrai DSN (avec identifiants) se définit dans .env.local ou en variable d'environnement, jamais ici.
MAILER_DSN=null://null
###< symfony/mailer ###

# Domaine Jitsi Meet utilisé pour les liens de visioconférence
JT_DOMAINE=https://meet.jit.si

# Visioconférence intégrée (Jitsi Meet IFrame API) via JaaS.
# Les vraies valeurs se définissent dans .env.local ou en variable d'environnement, jamais ici.
# Tant qu'elles sont vides, le bouton « Rejoindre » ouvre le lien JT_DOMAINE.
JAAS_APP_ID=
JAAS_KEY_ID=
JAAS_PRIVATE_KEY_PATH='%kernel.project_dir%/config/jaas/private.pem'

###> stripe/stripe-php ###
# Paiement des réservations par Stripe Checkout.
# STRIPE_SECRET_KEY : clé secrète du MODE TEST (sk_test_…, tableau de bord Stripe → Développeurs → Clés API).
#   La vraie valeur se définit dans .env.local ou en variable d'environnement, jamais ici.
# STRIPE_API_BASE : URL de l'API Stripe (https://api.stripe.com par défaut).
# STRIPE_WEBHOOK_SECRET : secret de signature du webhook (whsec_…), donné par Stripe à la création
#   du point de terminaison https://<domaine>/api/stripe/webhook (événements checkout.session.*),
#   ou par « stripe listen --forward-to localhost:8080/api/stripe/webhook » en local.
# Tests (test, ci) : passerelle Omnipay Mock, aucun appel à Stripe (config/services.yaml).
STRIPE_SECRET_KEY=
STRIPE_API_BASE=https://api.stripe.com
STRIPE_WEBHOOK_SECRET=

###< stripe/stripe-php ###