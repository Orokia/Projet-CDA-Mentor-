{% extends 'base.html.twig' %}

{% block title %}Mentor - Plateforme de formation{% endblock %}

{% block body %}

    {# =========================
       HERO
    ========================== #}

    <section class="hero">

        <div class="container-mentor">

            <div class="hero-content">

                <div class="hero-text">

                    <span class="hero-badge">
                        Plateforme de formation
                    </span>

                    <h1>
                        Apprenez avec les meilleurs formateurs.
                    </h1>

                    <p>
                        Réservez une session de formation individuelle
                        ou en groupe avec des professionnels qualifiés.
                    </p>

                    <div class="hero-actions">

                        <a
                            href="{{ path('app_formation') }}"
                            class="btn-mentor btn-mentor-primary"
                        >
                            Découvrir les formations
                        </a>

                        <a
                            href="{{ path('app_formateurs') }}"
                            class="btn-mentor btn-mentor-outline"
                        >
                            Trouver un formateur
                        </a>

                    </div>

                </div>

                <div class="hero-image">

                    <img
                        src="{{ asset('assets/images/Acceuil2.png' ) }}"
                        alt="Formation en ligne avec Mentor"
                    >

                </div>

            </div>

        </div>

    </section>


    {# =========================
       FORMATIONS
    ========================== #}

    <section class="formations-section">

        <div class="container-mentor">

            <div class="section-heading">

                <span class="section-label">
                    Nos formations
                </span>

                <h2>
                    Développez vos compétences
                </h2>

                <p>
                    Choisissez la formation adaptée à vos besoins
                    et progressez avec un formateur qualifié.
                </p>

            </div>

           {% if formations|length > 0 %}

            <div class="row g-4">

                {% for formation in formations %}

                    <div class="col-6 col-md-4 col-lg-3">

                        {% include 'components/formation_card.html.twig' with {
                            formation: formation
                        } %}

                    </div>

                {% endfor %}

            </div>

        {% else %}

                <div class="formation-empty">

                    <h3>
                        Aucune formation disponible
                    </h3>

                    <p>
                        Aucune formation n'est actuellement disponible.
                    </p>

                </div>

            {% endif %}

        </div>

    </section>


    {# =========================
       FORMATEURS
    ========================== #}

    <section class="formateurs-section">

        <div class="container-mentor">

            <div class="formateurs-content">

                {#
                <div class="formateurs-image">

                    <img
                        src="{{ asset('assets/images/utilisateurs/' ~ formateurs.image) }}"
                        alt="Formateur Mentor"
                    >

                </div>
                #}

                <div class="formateurs-text">

                    <span class="section-label">
                        Nos formateurs
                    </span>

                    <h2>
                        Apprenez auprès de professionnels expérimentés
                    </h2>

                    <p>
                        Des experts dans leur domaine, disponibles
                        pour vous accompagner avec des formations
                        personnalisées.
                    </p>

                    <ul>

                        <li>
                            Plus de 50 formateurs
                        </li>

                        <li>
                            Sessions en ligne
                        </li>

                        <li>
                            Planning flexible
                        </li>

                        <li>
                            Avis vérifiés
                        </li>

                    </ul>

                    <a
                        href="{{ path('app_formateurs') }}"
                        class="btn-mentor btn-mentor-primary"
                    >
                        Voir tous les formateurs
                    </a>

                </div>

            </div>

        </div>

    </section>

{% endblock %}