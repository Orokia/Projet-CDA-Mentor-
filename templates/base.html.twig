<!DOCTYPE html>
<html lang="fr">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1">

    <meta name="theme-color" content="#000000">

	<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"
>

    <title>
        {% block title %}
            Mentor
        {% endblock %}
    </title>

    <meta name="description"
          content="Mentor - Plateforme de réservation de formations">

    {% block stylesheets %}
    {% endblock %}

    {% block javascripts %}
        {{ importmap('app') }}
    {% endblock %}

</head>


<body>

    {# Permet aux utilisateurs du clavier de sauter la navigation #}
    <a href="#contenu-principal" class="skip-link">
        Aller au contenu principal
    </a>

    {% include 'components/navbar.html.twig' %}

    <main id="contenu-principal" tabindex="-1">

        {% include 'components/flashes.html.twig' %}

        {% block body %}
        {% endblock %}

    </main>

   {% include 'components/footer.html.twig' %}

</body>

</html>
